# Kuver settings. install.sh fills in the password for you.
# After a change: docker compose up -d

# Database password: any long random text. Keep it; you need it to restore a backup.
POSTGRES_PASSWORD=change-me

# Port on this machine.
KUVER_PORT=4000

# ---- HTTPS with your own domain (to use Kuver outside the venue) -------------------------------
# Point the domain's DNS at this machine, open ports 80 and 443, then set these four lines.
# KUVER_DOMAIN=kuver.example.com
# COMPOSE_PROFILES=https
# SECURE_COOKIES=1
# TRUST_PROXY=1

# ---- Team ---------------------------------------------------------------------------------------
# 0 (default): after the first account (the owner), people join only with an invite link.
# 1: anyone who can open the address may sign up.
KUVER_OPEN_SIGNUP=0

# ---- Daily summary ------------------------------------------------------------------------------
# Local hour for the end-of-day notification, or off.
DIGEST_HOUR=22

# ---- Enterprise ---------------------------------------------------------------------------------
# A licence key unlocks more locations, area managers and the audit log. Empty: Community (free).
KUVER_LICENSE_KEY=

# ---- Anonymous statistics -----------------------------------------------------------------------
# Once a week: a random install id, the version and the number of locations and cameras.
# Never names, emails, addresses, pictures or video. Set to off to turn it off.
KUVER_TELEMETRY=on

# A specific version instead of the newest (e.g. 1.0.0).
# KUVER_VERSION=latest
